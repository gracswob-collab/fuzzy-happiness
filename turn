def turn():
    print("Would you like to pick up a card,", players[i] + "?", "YES or NO?")
    response = input()
    if response == "YES":
        add_card(i)
        print("This is your hand:")
        print(hands[i])
    elif response == "NO":
        print("You're a wimp.")
        print("This is your loser hand:")
        print(hands[i])
    else:
        while response != "YES" or response != "NO":
            print("Sorry, I didn't understand.")
            print("Would you like to pick up a card,", players[i] + "?", "YES or NO?")
            response = input()
            if response == "YES":
                add_card(i)
                print("This is your hand:")
                print(hands[i])
                break
            if response == "NO":
                print("You're a wimp.")
                print("This is your loser hand:")
                print(hands[i])
                break

for i in range(0, int(number_of_players)):
    turn()
