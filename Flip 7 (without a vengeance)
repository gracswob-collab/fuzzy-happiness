        winner = total_score.index(max(total_score))
        print(players[winner], "won with", total_score[winner], "points. Congrats.")
    elif total_score.count(max(total_score)) >= 2:
        print("Those who won are listed below. It was a tie.")
        number_of_winners = total_score.count(max(total_score))
        while number_of_winners > 0:
            for i in range(0, int(number_of_players)):
                if total_score[i] == max(total_score):
                    print(players[i], "tied for 1st with", total_score[i], "points.")
                    number_of_winners = number_of_winners - 1

