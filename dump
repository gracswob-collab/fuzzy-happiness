def round():
    global end_turn
    while end_turn != number_of_players:
        for i in range(0, int(number_of_players)):
            if hands[i] and hands[i][-1] == 'DONE':
                print(players[i], "you're a wimp.")
                print("")
                continue
            turn(i)
            freeze(i)
            flip3(i)
            if end_turn == number_of_players:
                break
    return(count_score())

